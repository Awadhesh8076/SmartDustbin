# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
backend/.env
backend/*.env
!backend/.env.example

# Local SQLite databases & backups
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
storage/*.db
storage/*.db-journal
storage/*.sqlite3
storage/backups/

# Generated runtime scan frames & uploaded datasets
storage/scans/*
!storage/scans/.gitkeep
storage/dataset/*
!storage/dataset/.gitkeep
storage/model/*
!storage/model/.gitkeep

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

