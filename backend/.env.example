# SmartDustbin Backend Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=False

# Database
DATABASE_URL=sqlite:///storage/smartdustbin.db

# Storage Directory
STORAGE_DIR=storage

# Default Operating Mode (SIMULATION or REAL_HARDWARE)
DEFAULT_MODE=SIMULATION

# ESP32 Default Network Endpoints (Used in Real Hardware Mode)
DEFAULT_ESP32_CAM_IP=192.168.4.10
DEFAULT_ESP32_DEVKIT_IP=192.168.4.20
DEFAULT_CAMERA_TIMEOUT=4.0
DEFAULT_DEVKIT_TIMEOUT=10.0
