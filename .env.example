# SmartDustbin Environment Configuration Template
# Copy this file to .env and adjust IP addresses as needed for your local Wi-Fi network

# ==========================================
# 1. FastAPI Backend Settings
# ==========================================
# Listen on 0.0.0.0 to allow access from local machine and LAN devices
HOST=0.0.0.0
PORT=8000
DEFAULT_MODE=SIMULATION  # SIMULATION or REAL_HARDWARE
DATABASE_URL=sqlite:///storage/smartdustbin.db

# ==========================================
# 2. React / Vite Frontend Settings
# ==========================================
# In local development, leaving VITE_API_URL empty or /api uses the Vite proxy
# For remote LAN devices accessing the web UI directly, set this to your laptop's Wi-Fi IP:
# VITE_API_URL=http://192.168.1.100:8000/api
VITE_API_URL=/api

# ==========================================
# 3. ESP32 Microcontrollers (Station Mode / DHCP)
# ==========================================
# Initial fallback IPs. Real assigned DHCP IPs are configured through the Device Management web UI
DEFAULT_ESP32_CAM_IP=192.168.4.10
DEFAULT_ESP32_DEVKIT_IP=192.168.4.20
